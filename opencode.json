{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "webfetch": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*firebase-adminsdk*.json": "deny",
      "*.keystore": "deny",
      "*.jks": "deny"
    },
    "edit": {
      "*": "allow",
      "opencode.json": "deny",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "external_directory": {
      "*": "deny"
    },
    "bash": {
      "*": "ask",
      "git push *": "ask",
      "npm install *": "ask",
      "npm i *": "ask",
      "npx expo install *": "ask",
      "vercel *": "ask",
      "eas *": "ask",
      "sudo *": "deny",
      "curl*": "deny",
      "wget*": "deny",
      "Invoke-WebRequest*": "deny",
      "Invoke-RestMethod*": "deny",
      "iwr *": "deny",
      "irm *": "deny",
      "node -e*": "deny",
      "cat *.env*": "deny",
      "type *.env*": "deny",
      "Get-Content *.env*": "deny",
      "rm -rf *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git reset --hard *": "deny",
      "vercel env pull *": "deny"
    }
  }
}
